# Bring your own model: every key below comes from your own provider account.
# Copy this file to .env and fill it in. Nothing here is required to capture and keyword-search notes.

# Chat model used to answer questions. "openai" means any OpenAI-compatible API; "anthropic" means Claude.
EXOKORTEX_LLM_PROVIDER=openai
EXOKORTEX_LLM_API_KEY=
EXOKORTEX_LLM_MODEL=
# Leave empty for the provider's default endpoint. Examples:
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://host.docker.internal:11434/v1   (any non-empty API key works)
#   LM Studio:  http://host.docker.internal:1234/v1
EXOKORTEX_LLM_BASE_URL=

# Embeddings use an OpenAI-compatible /embeddings endpoint.
# With the openai provider these fall back to the LLM key and base URL above.
EXOKORTEX_EMBEDDING_API_KEY=
EXOKORTEX_EMBEDDING_BASE_URL=
EXOKORTEX_EMBEDDING_MODEL=text-embedding-3-small
# Must match the model's output size. It is fixed when the database is first migrated.
EXOKORTEX_EMBEDDING_DIM=1536

# Optional: require "Authorization: Bearer <token>" on the HTTP API (except /health).
EXOKORTEX_API_TOKEN=