# Copy the worker block into apps/worker/.dev.vars for local development.
# Deployed values are Worker secrets, never this file.
# Run `pnpm setup` to generate apps/worker/.dev.vars with a fresh encryption key.

# development | production. AUTH_MODE=dev is refused unless this is development.
ENVIRONMENT=development

# dev | clerk
AUTH_MODE=dev

# 32-byte key, base64. Generated by `pnpm setup`.
ENCRYPTION_KEY=

# Signs the local dev session cookie. Defaults to ENCRYPTION_KEY when empty.
DEV_SESSION_SECRET=

# Browser origin. Vite serves the UI here and proxies /api to the worker.
APP_BASE_URL=http://127.0.0.1:5173

# Clerk. Required only when AUTH_MODE=clerk.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# GitHub App. You create the app; see docs/integrations/github.md.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
