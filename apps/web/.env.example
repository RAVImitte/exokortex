# Browser only. Copy to apps/web/.env.local, which is gitignored.
# Vite reads this folder. It does not read apps/worker/.dev.vars.
# Restart `pnpm dev` after you edit .env.local.

# dev shows the email form. clerk shows the Clerk sign-in widget.
# Keep this equal to AUTH_MODE in apps/worker/.dev.vars.
VITE_AUTH_MODE=dev

# Same value as CLERK_PUBLISHABLE_KEY in apps/worker/.dev.vars.
# This key is public. Do not put CLERK_SECRET_KEY here.
VITE_CLERK_PUBLISHABLE_KEY=
