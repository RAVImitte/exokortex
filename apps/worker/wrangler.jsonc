{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "exokortex",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exokortex",
      "database_id": "9f82b50d-cec9-45e9-b647-e24ed0968c15",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "exokortex-jobs" }],
    "consumers": [{ "queue": "exokortex-jobs", "max_batch_size": 5 }],
  },
  "triggers": {
    "crons": ["15 * * * *"],
  },
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_MODE": "clerk",
    "APP_BASE_URL": "https://exokortex.exokortex.workers.dev",
    "CLERK_PUBLISHABLE_KEY": "pk_test_bW9kZWwtaGFsaWJ1dC05MDQxLmNsZXJrLmFjY291bnRzLmRldiQ",
    "GITHUB_APP_ID": "5395253",
    "GITHUB_APP_SLUG": "exokortex-dev",
  },
}
